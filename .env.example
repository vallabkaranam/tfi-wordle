# =========================================================
# FRONTEND CONFIGURATION
# =========================================================
# URL to your deployed backend API (no trailing slash)
# Example: https://tfi-wordle-backend.onrender.com/api
NEXT_PUBLIC_API_URL=

# =========================================================
# BACKEND CONFIGURATION
# =========================================================
# Comma-separated list of allowed frontend URLs (CORS)
# Include your deployed frontend URL and localhost for dev
# Example: https://tfi-wordle.onrender.com,http://localhost:3000
CORS_ORIGINS=

# (Optional) TMDB API Key for real data
# If omitted, the backend will serve mock data (Baahubali, RRR, etc.)
TMDB_API_KEY=
